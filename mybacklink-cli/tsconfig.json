{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"outDir": "dist",
		"rootDir": "src",
		"strict": true,
		"declaration": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"lib": ["ES2022", "DOM"],
		"types": ["node"],
		"typeRoots": ["./node_modules/@types", "../../nextjs/node_modules/@types"]
	},
	"include": ["src/**/*.ts"]
}
